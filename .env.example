# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# A fully local Ollama run (configs/models.ollama.yaml) needs none of these.

# OpenRouter — one key, many models, spend caps in the dashboard.
# Used by configs/judge.openrouter.yaml
OPENROUTER_API_KEY=sk-or-...

# Anthropic direct — used by configs/judge.claude.yaml and configs/models.live.yaml
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI direct — only if you point a config at api.openai.com
# OPENAI_API_KEY=sk-...

# Ollama ignores the key entirely; present so the config's api_key_env resolves.
OLLAMA_API_KEY=not-needed
