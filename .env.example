# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Only needed for live runs that use a hosted model or judge. A fully local
# Ollama run (configs/models.ollama.yaml) needs none of these.

# Used by configs/judge.claude.yaml and configs/models.live.yaml
ANTHROPIC_API_KEY=sk-ant-...

# Used only if you point a config at OpenAI
# OPENAI_API_KEY=sk-...

# Ollama ignores the key entirely; present so the config's api_key_env resolves.
OLLAMA_API_KEY=not-needed
